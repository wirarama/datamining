import pandas as pd
from random import randint,uniform


df = pd.read_csv("out.csv") # diubah kenumerik
dfcluster = df.drop('status', axis=1) #untuk clustering


dfcluster


from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score


kmeans = KMeans(n_clusters=4)
kmeans.fit(dfcluster[['suhu udara','kelembaban udara','suhu tanah','kelembaban tanah','cahaya']])


print(kmeans.cluster_centers_)


print(kmeans.labels_)


clust = []
j = 0
for i in dfcluster[['suhu udara','kelembaban udara','suhu tanah','kelembaban tanah','cahaya']].values:
    clust.append([i[0],i[1],i[2],i[3],i[4],kmeans.labels_[j]])
    j+=1
dfclust = pd.DataFrame(clust,columns=['suhu udara','kelembaban udara','suhu tanah','kelembaban tanah','cahaya','status'])


dfclust


"""
untuk klasifikasi
"""
fitur = ['suhu udara','kelembaban udara','suhu tanah','kelembaban tanah','cahaya']
#fitur yang digunakan dalam menentukan jarak label clustering dan clasifikasi (unsupervised dan supervised)
label = ['mendung siram', 'mendung kering','cerah siram','cerah kering']
#sesuai label supervised atau classifikasi awal
for i in label: #loop per label
    print(i,end=" ")
    for j in fitur: #loop per fitur
        print(df[(df['status']==i)].describe().loc['mean'][j],end=" ")
        #mencetak semua label dan fiturnya. urutan fitur sesuai dengan list fitur diatas
    print()


"""
untuk clustering
"""
for i in range(4):
    print(i,end=" ")
    for j in fitur:
        print(dfclust[(dfclust['status']==i)].describe().loc['mean'][j],end=" ")
        #0 hingga 3 adalah hasil label cluster yang akan dicocokkan dengan label klasifikasi diatas
    print()


print(list(kmeans.labels_))


print(list(df['status'].unique()))


penyesuaian = [x for x in range(4)]
fitur = ['suhu udara','kelembaban udara','suhu tanah','kelembaban tanah','cahaya']
label = ['mendung siram', 'mendung kering','cerah siram','cerah kering']
for i in range(4):
    dekat = 1000000000
    for j in range(4):
        meanclust = dfclust[(dfclust['status']==i)].describe().loc['mean']
        meanclass = df[(df['status']==label[j])].describe().loc['mean']
        meanclust = meanclust[fitur[1]]+meanclust[fitur[4]]
        meanclass = meanclass[fitur[1]]+meanclass[fitur[4]]
        dekat1 = abs(meanclust-meanclass)
        print(i,j,dekat1)
        if dekat>dekat1:
            penyesuaian[i]=j
            dekat = dekat1
print(penyesuaian)


label_hasil_clustering = []
for x in list(kmeans.labels_):
    label_hasil_clustering.append(penyesuaian[x])
#karena hasil label clustering tidak jadi satu list dengan data clusternya, digabungkan per baris secara manual


print(label_hasil_clustering)
print(list(df['status']))


dataasli = df.values #data asli dari pelabelan awal klasifikasi
databarujelek = [] #data pelabelan klasifikasi yang tidak sama dengan clustering
databarubagus = [] #data pelabelan klasifikasi yang sama dengan clustering
salah = 0 #mencatat jumlah data yang dipindahkan
label_asli = list(df['y']) #label klasifikasi yang ditunjuk
for i in range(len(label_hasil_clustering)): #loop berdasarkan semua label clustering 0 sampai 3
    if label_hasil_clustering[i] != label_asli[i]: #jika tidak sama hasil meansnya (sebelumnya centroid, sekarang diganti means)
        databarujelek.append(i) #dimasukkan di data tidak sesuai
        salah += 1 #hitung data yang salah menurut clustering
    else: #selain itu
        databarubagus.append(i) #dimasukkan di data sesuai
        
print(salah)
print(500-salah)






